  "line:Assets/Cutscenes/chapter11/sheep.yarn-debugSheepLevels-11329": "第 3 关",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-debugSheepLevels-11330": "第 4 关",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-debugSheepLevels-11331": "第 5 关",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-debugSheepLevels-11332": "第 6 关",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-debugSheepLevels-11333": "第 7 关",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-debugSheepLevels-11334": "第 8 关",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-debugSheepLevels-11335": "不玩了",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11336": "FARMER: 多谢帮忙，年轻人。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11337": "FARMER: 嘿！你！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11338": "FARMER: 去年你施过魔法的那些羊……今年春天生小羊了。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11339": "FARMER: 现在小羊也全有魔法了！可还是一样又倔又笨。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11340": "FARMER: 得请你来帮我管管这些羊，放心，不会让你白忙的。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11341": "具体怎么做？",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11342": "好。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11343": "现在不行。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11344": "FARMER: 你是来帮忙管那些羊的吗？",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11345": "再说说怎么做？",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11346": "好。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStackingIntro-11347": "现在不行。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStacker_rewards-11348": "获得 1500 瓦尔！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStacker_rewards-11349": "获得祝福之手！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStacker_rewards-11350": "获得 4000 瓦尔！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStacker_rewards-11351": "获得终极圣灵药！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStacker_rewards-11352": "获得 7500 瓦尔！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStacker_rewards-11353": "获得速度宝典！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStacker_rewards-11354": "获得贝壳项链！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepStacker_rewards-11355": "获得金羊毛！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-clueToFarmer-11356": "WOMAN: 那个老农夫在找你，好像是魔法羊的事。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-clueToFarmer-11357": "WOMAN: 他的地在东边沼泽那里。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepTutorialText-11358": "FARMER: 去年被你施了魔法以后，我的羊就倔得很，拿吃的能哄它们进圈，可进去就不肯出来了！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepTutorialText-11359": "FARMER: 只有黑羊听我的话，你得把其他羊都叠在它身上，再让它驮着出去。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepTutorialText-11360": "FARMER: 用闪电把羊吓到黑羊背上，叠高点！",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepTutorialText-11361": "FARMER: 灰羊挨电会走一格，棕羊会走两格，除非路上有东西挡着。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepTutorialRed-11362": "FARMER: 红羊会那个叫什么……传送，对，就是那个。",
  "line:Assets/Cutscenes/chapter11/sheep.yarn-sheepTutorialRed-11363": "FARMER: 它们走的是 L 形，从不同的方向电它们，落点也不同。"
}
