  "dialogue": {
    "line:069f0a1": "开始本的篇章？",
    "line:0194a38": "是",
    "line:0fcc426": "否",
    "line:Assets/Cutscenes/ChapterSelect.yarn-ChapterSelect_Alex-311": "开始亚历珊德拉的篇章？",
    "line:Assets/Cutscenes/ChapterSelect.yarn-ChapterSelect_Alex-312": "是",
    "line:Assets/Cutscenes/ChapterSelect.yarn-ChapterSelect_Alex-313": "否",
    "line:09fc433": "开始科黛莉娅的篇章？",
    "line:08deb45": "是",
    "line:066bff0": "否",
    "line:Assets/Cutscenes/ChapterSelect.yarn-ChapterSelect_Nikolai-325": "开始尼古拉的篇章？",
    "line:Assets/Cutscenes/ChapterSelect.yarn-ChapterSelect_Nikolai-326": "是",
    "line:Assets/Cutscenes/ChapterSelect.yarn-ChapterSelect_Nikolai-327": "否",
    "line:0403dc3": "取消",
    "line:09a2d75": "返回标题画面",
    "line:03af3a9": "确定吗？尚未保存的进度将会丢失。",
    "line:0419031": "否",
    "line:07b5171": "是",
    "line:Assets/Cutscenes/ChapterSelect.yarn-ChapterSelect_Cancel-301": "退出",
    "line:0e8f0b4": "确定吗？尚未保存的进度将会丢失。",
    "line:0c61358": "否",
    "line:00b61b4": "是",
    "line:Assets/Cutscenes/ChapterSelect.yarn-ChapterSelect_Ben-308": "古瓮铭文，<br>藏于阿科斯古代文化博物馆——<br><br>“清晨，我们醒来，将船首转向天际。<br>玫瑰色的曙光，向酒色的深海舒展指尖。<br>我们将掺着祭血的奠酒倾入海中，<br>浪花如胡狼的舌头，<br>舔舐着坚实的橡木船身。<br>",
    "line:Assets/Cutscenes/ChapterSelect.yarn-ChapterSelect_Ben-309": "诸神收下献礼，赐予恩惠。<br>不久，船首昂起，<br>环绕圣祠、永不停息的风之精魂鼓满船帆，<br>护送我们安然渡海。<br>纵使四周惊涛拍击，我们仍安卧于风的怀抱；<br>远方，一道道闪电刺入海面，<br>如巨大的标枪，在深渊中寻觅猎物。”<br>",
    "line:Assets/Cutscenes/ChapterSelect.yarn-ChapterSelect_Ben-310": "后来有人在瓮底刻下一句涂鸦——<br><br>“你妈就喜欢那杆大标枪。”"
  }
}
